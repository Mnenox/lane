---
// 零星涂鸦标记：空处点缀，周期性霓虹闪烁（v1.3）
const marks = [
  { x: '5%', y: '16%', r: -8, c: 'var(--magenta)', d: '0s', kind: 'star' },
  { x: '90%', y: '10%', r: 6, c: 'var(--blue)', d: '2.2s', kind: 'arrow' },
  { x: '10%', y: '74%', r: -4, c: 'var(--yellow)', d: '4.1s', kind: 'zig' },
  { x: '86%', y: '66%', r: 9, c: 'var(--green)', d: '1.3s', kind: 'circlex' },
  { x: '44%', y: '88%', r: -6, c: 'var(--red)', d: '5.6s', kind: 'hash' },
  { x: '72%', y: '26%', r: 4, c: 'var(--magenta)', d: '3.4s', kind: 'tag' }
];
---
<div class="graffiti" aria-hidden="true">
  {marks.map((m) => (
    <span class="gmark" style={`left:${m.x};top:${m.y};--gc:${m.c};--gd:${m.d};transform:rotate(${m.r}deg)`}>
      {m.kind === 'star' && <svg viewBox="0 0 40 40"><path d="M20 2l4 12 12-4-8 10 10 8-12-2-4 12-4-12-12 2 10-8-8-10 12 4z" /></svg>}
      {m.kind === 'arrow' && <svg viewBox="0 0 40 40"><path d="M4 32 L28 10 M28 10 l-11 2 M28 10 l-2 11" /></svg>}
      {m.kind === 'zig' && <svg viewBox="0 0 40 40"><path d="M2 24 l8-12 6 14 8-14 6 14 8-12" /></svg>}
      {m.kind === 'circlex' && <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="14" /><path d="M12 12l16 16M28 12l-16 16" /></svg>}
      {m.kind === 'hash' && <svg viewBox="0 0 40 40"><path d="M14 4l-4 32M28 4l-4 32M4 14h32M2 26h32" /></svg>}
      {m.kind === 'tag' && <svg viewBox="0 0 80 30"><text x="0" y="22">lane!</text></svg>}
    </span>
  ))}
</div>