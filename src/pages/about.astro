---
import Base from '../layouts/Base.astro';
import Alley from '../components/Alley.astro';
import Graffiti from '../components/Graffiti.astro';
import { config, url } from '../theme/config';
import { PALETTE } from '../theme/presets';
const paragraphs = config.about.split(/\n\n+/).filter(Boolean);
const LINK_CYCLE = [PALETTE.yellow, PALETTE.blue, PALETTE.green, PALETTE.red];
---
<Base title="关于">
  <Alley compact />
  <main id="main" class="wall read-wall">
    <div class="read-top"><a class="back-board" href={url('/')}>← 回到墙面</a></div>
    <section class="boards">
      <Graffiti />
      <article class="board board-main" style={`--bc:${PALETTE.magenta};--d:0ms`}>
        <svg class="board-doodle" viewBox="0 0 60 100" aria-hidden="true">
          <path d="M14 92 L34 56 L24 52 L46 14 M46 14 l-16 5 M46 14 l-3 16" />
        </svg>
        <h1 class="board-title">关于 {config.siteName}</h1>
        {paragraphs.map((p) => <p class="board-line">{p}</p>)}
      </article>
      {config.social.length > 0 && (
        <div class="board-row">
          {config.social.map((s, i) => (
            <a
              class="board board-link"
              href={s.href}
              style={`--bc:${LINK_CYCLE[i % LINK_CYCLE.length]};--rot:${i % 2 === 0 ? -0.6 : 0.5}deg;--d:${180 + i * 140}ms`}
            >
              <span class="board-label">{s.label.toUpperCase()}</span>
              <span class="board-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )}
    </section>
  </main>
  <footer class="site-foot">
    © {new Date().getFullYear()} {config.author} · {config.siteName} ·
    <a href={url('/archive/')}>归档</a>
  </footer>
</Base>
<script>
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.board').forEach((b) => io.observe(b));
</script>